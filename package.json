{
  "name": "seo-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate --schema=prisma/schema.prisma",
    "dev": "next dev",
    "build": "prisma generate --schema=prisma/schema.production.prisma && next build",
    "start": "next start",
    "worker": "tsx src/worker.ts",
    "lint": "next lint",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:dev:production": "prisma migrate dev --schema=prisma/schema.production.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.production.prisma",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.12",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "lucide-react": "^1.44.0",
    "motion": "^13.2.0",
    "next": "15.5.27",
    "psl": "^1.15.0",
    "react": "^18",
    "react-dom": "^18",
    "robots-parser": "^3.0.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/psl": "^1.1.3",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.27",
    "prisma": "^6.19.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
